<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="LaunchDarklyAccountTelemetry.Usage/LaunchDarklyAccountTelemetry.Usage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LaunchDarklyAccountTelemetry.Usage/**;LaunchDarklyAccountTelemetry.Tests/**;LaunchDarklyAccountTelemetry.AppHost/**;deploy/**" />
    <Content Remove="LaunchDarklyAccountTelemetry.Usage/**;LaunchDarklyAccountTelemetry.Tests/**;LaunchDarklyAccountTelemetry.AppHost/**;deploy/**" />
    <None Remove="LaunchDarklyAccountTelemetry.Usage/**;LaunchDarklyAccountTelemetry.Tests/**;LaunchDarklyAccountTelemetry.AppHost/**;deploy/**" />
  </ItemGroup>

</Project>
