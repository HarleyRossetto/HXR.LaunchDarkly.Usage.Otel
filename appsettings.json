{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LaunchDarklyUsage": {
    "Interval": "00:15:00",
    "PublicationDelay": "00:20:00",
    "InitialLookbackHours": 24,
    "RescrapeHours": 2,
    "ExtraGroupBy": [],
    "Otlp": {
      "Endpoint": "http://localhost:4318",
      "MetricName": "launchdarkly.service_connections.minutes"
    }
  }
}
