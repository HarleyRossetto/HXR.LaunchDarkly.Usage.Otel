{
  "uid": "ld-service-connections",
  "title": "LaunchDarkly service connections",
  "tags": [
    "launchdarkly"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "label": "Project",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(launchdarkly_service_connections, launchdarkly_project_name)",
          "refId": "p"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "label": "Environment",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\"}, launchdarkly_environment_key)",
          "refId": "e"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "outliers",
        "type": "custom",
        "label": "Outlier count",
        "query": "5,10,20,50",
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "text": "5",
            "value": "5",
            "selected": false
          },
          {
            "text": "10",
            "value": "10",
            "selected": true
          },
          {
            "text": "20",
            "value": "20",
            "selected": false
          },
          {
            "text": "50",
            "value": "50",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "type": "stat",
      "title": "Total service connections accrued in range",
      "description": "Sum of all hourly values (all projects and environments) across the selected time window.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(sum_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[$__range]))"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Service connections per hour (raw API value)",
      "description": "Raw hourly values from the LaunchDarkly API; each sample is stamped at the start of its usage hour.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "interval": "1h",
          "legendFormat": "{{launchdarkly_project_name}} / {{launchdarkly_environment_key}}",
          "expr": "sum by (launchdarkly_project_name, launchdarkly_environment_key) (last_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hour-over-hour change: biggest movers",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "interval": "1h",
          "legendFormat": "{{launchdarkly_project_name}} / {{launchdarkly_environment_key}}",
          "expr": "(sum by (launchdarkly_project_name, launchdarkly_environment_key) (last_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[1h])) - sum by (launchdarkly_project_name, launchdarkly_environment_key) (last_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[1h] offset 1h))) and on (launchdarkly_project_name, launchdarkly_environment_key) topk($outliers, max_over_time(abs((sum by (launchdarkly_project_name, launchdarkly_environment_key) (last_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[1h])) - sum by (launchdarkly_project_name, launchdarkly_environment_key) (last_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[1h] offset 1h))))[$__range:1h] @ end()))"
        }
      ],
      "description": "Only the environments with the largest hour-over-hour swing (by absolute change) anywhere in the time window; the number shown is the \"Outlier count\" variable."
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Sum over range by project",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{launchdarkly_project_name}}",
          "expr": "sort_desc(sum by (launchdarkly_project_name) (sum_over_time(launchdarkly_service_connections{launchdarkly_project_name=~\"$project\", launchdarkly_environment_key=~\"$environment\"}[$__range])))"
        }
      ],
      "description": "Total accrued in the window, per project (environments merged)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latest ingested usage hour",
      "description": "Start of the newest usage hour published by the ingestion service.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "max({__name__=~\"launchdarkly_usage_ingest_last_hour.*\"}) * 1000"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ingestion lag",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10800
              },
              {
                "color": "red",
                "value": 21600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "time() - max({__name__=~\"launchdarkly_usage_ingest_last_hour.*\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Failed ingestion runs (range)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase({__name__=~\"launchdarkly_usage_ingest_failures.*\"}[$__range])) or vector(0)"
        }
      ]
    }
  ]
}
